  ["^Rename \"(.+)\"$", "重命名“$1”"],
  ["^Open \"(.+)\"$", "打开“$1”"],
  ["^Show (\\d+) more$", "再显示 $1 项"],
  ["^Show (\\d+) results?$", "显示 $1 个结果"],
  ["^(\\d+) new$", "$1 条新内容"],
  ["^Every (\\d+) (minutes?|hours?|days?)$", "每 $1 分钟"]
