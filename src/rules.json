  ["^(\\d+)\\s*(h|hr|hrs|hours?)\\s+ago$", "$1 小时前"],
  ["^(\\d+)\\s*(d|days?)\\s+ago$", "$1 天前"],
  ["^(\\d+)\\s+(results?|matches?)$", "$1 个结果"],
