  ["^(\\d+)\\s+insertions?\\(\\+\\)$", "$1 行新增(+)"],
  ["^(\\d+)\\s+deletions?\\(-\\)$", "$1 行删除(-)"],
  ["^(\\d+)\\s+(comments?)$", "$1 条评论"],
